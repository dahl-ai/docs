        },
        {
          "anchor": "Account",
          "icon": "user",
          "href": "https://inference.dahl.global/account"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Chat",
        "href": "https://inference.dahl.global/chat"
      },
      {
        "href": "https://inference.dahl.global/account",
