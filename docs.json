{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Dahl",
  "colors": {
    "primary": "#F70302",
    "light": "#FFB5D6",
    "dark": "#C40202"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "pages": [
      {
        "group": "Getting started",
        "pages": [
          "index",
          "quickstart"
        ]
      },
      {
        "group": "Guides",
        "pages": [
          "authentication",
          "models"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Try chat",
          "href": "https://inference.dahl.global/chat",
